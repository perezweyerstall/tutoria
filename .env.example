# TutorIA — Ejemplo de configuración local
# Se copia automáticamente a .env en la primera ejecución si .env no existe.
# Nunca subas claves de API ni credenciales reales al repositorio.

# Ruta local de la base de datos SQLite (almacenada en tu computadora por defecto)
DATABASE_URL=./data/tutoria.db

# Carpeta local para respaldos JSON generados por la persona usuaria
BACKUP_DIR=./data/backups

# Desactivar telemetría del framework (no se usa telemetría ni analítica)
NEXT_TELEMETRY_DISABLED=1

# Puerto HTTP local para el servidor de desarrollo o producción
PORT=3000

# Opcional: credenciales de un endpoint compatible con OpenAI para generar borradores.
# Déjalo vacío para usar el generador determinista 100 % local integrado (por defecto).
OPTIONAL_AI_API_KEY=
OPTIONAL_AI_BASE_URL=
OPTIONAL_AI_MODEL=
